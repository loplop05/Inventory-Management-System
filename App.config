<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <connectionStrings>
    <!-- Local credentials: copy App.config.local.example to App.config.local (gitignored). -->
    <add name="InventoryDB" connectionString="Server=.;Database=InventoryDB;Integrated Security=True;" />
  </connectionStrings>
  <appSettings>
    <add key="AppName" value="ElectroPOS Pro" />
    <add key="StoreName" value="Main Store" />
    <add key="TaxRate" value="0.07" />
    <add key="SmtpServer" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUseSSL" value="true" />
    <add key="SmtpUsername" value="" />
    <add key="SmtpPassword" value="" />
    <add key="SmtpFromEmail" value="" />
    <add key="SmtpFromName" value="ElectroPOS Pro" />
    <add key="LowStockAlertEmail" value="" />
    <add key="BackupDirectory" value="" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>